{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doctk",
  "version": "0.1.0",
  "identifier": "com.doctk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../build/gui-dist"
  },
  "app": {
    "windows": [
      {
        "title": "doctk — document processing tools",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
